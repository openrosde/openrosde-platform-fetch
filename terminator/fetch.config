[global_config]
  suppress_multiple_term_dialog = True
[keybindings]
[profiles]
  [[default]]
    background_color = "#300a24"
    background_darkness = 0.9
    background_type = transparent
    font = Ubuntu Mono 12
    foreground_color = "#ffffff"
    use_system_font = False
[layouts]
  [[default]]
    [[[child1]]]
      parent = window0
      profile = default
      type = Terminal
    [[[window0]]]
      parent = ""
      type = Window
  [[openrosde-fetch-term-11-default-gazebo]]
    [[[child0]]]
      fullscreen = False
      last_active_window = True
      maximised = True
      order = 0
      parent = ""
      title = OpenRoSDE (Fetch)
      type = Window
    [[[child1]]]
      order = 0
      parent = child0
      ratio = 0.5
      type = HPaned
    [[[child11]]]
      order = 1
      parent = child1
      ratio = 0.5
      type = VPaned
    [[[child12]]]
      order = 0
      parent = child11
      ratio = 0.5
      type = HPaned
    [[[child15]]]
