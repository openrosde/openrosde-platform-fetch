<?xml version="1.0" encoding="utf-8"?>

<launch>

  <!-- OpenRoSDE-specific launch: main entry point for Fetch end effector teleoperation. -->
  <!-- It starts the Fetch Cartesian twist relay so teleoperation is live on launch with no manual controller switch. -->
  <!-- Publish geometry_msgs/TwistStamped end effector velocity commands on 'fetch_ee_cmd_vel' (for example from the Coarobo Sightline application) to move the arm. -->

  <!-- Input end effector twist command (geometry_msgs/TwistStamped), as published by the Quest application. -->
  <arg name="input_twist_topic" default="fetch_ee_cmd_vel" />
  <!-- Output command topic consumed by the Fetch Cartesian twist controller. -->
  <arg name="command_out_topic" default="/arm_controller/cartesian_twist/command" />

  <!-- Start already in velocity control so the user does not need to switch anything. -->
  <arg name="start_in_velocity_control" default="true" />

  <!-- Steady send period. -->
  <!-- Fetch needs a continuous stream (at least 20 Hz) or the arm can fall. -->
  <arg name="send_period" default="0.050" />
  <!-- Safety limits. -->
  <!-- Keep small so there is always time to reach the stop button. -->
  <arg name="max_linear_velocity" default="0.05" />
  <arg name="max_angular_velocity" default="0.10" />

  <!-- 'pass_all_args' forwards every arg declared above to the Coarobo Sightline teleop launch, so a new parameter only needs to be added in one place. -->
  <include file="$(find openrosde_fetch_teleop)/launch/fetch_teleop_sightline.launch" pass_all_args="true" />

</launch>
