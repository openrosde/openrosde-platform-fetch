<?xml version="1.0" encoding="utf-8"?>

<launch>

  <!-- https://fetchrobotics.github.io/docs/gazebo.html -->

  <include file="$(find fetch_gazebo)/launch/playground.launch" />

  <!-- Maximize the Gazebo window after it opens. -->
  <node name="maximize_gazebo" pkg="openrosde_launch" type="maximize-app-window.bash" args="Gazebo" />

</launch>
