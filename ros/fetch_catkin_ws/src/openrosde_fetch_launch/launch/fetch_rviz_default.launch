<?xml version="1.0" encoding="utf-8"?>

<launch>

  <!-- https://fetchrobotics.github.io/docs/ -->
  <!-- Upstream default: $(find fetch_navigation)/config/navigation.rviz -->

  <!-- Display Rviz with a custom layout to monitor the Fetch robot. -->

  <node name="rviz" pkg="rviz" type="rviz" required="true" args="-d $(find openrosde_fetch_launch)/config/rviz/fetch_rviz_default.rviz" />

  <!-- Maximize the RViz window after it opens. -->
  <node name="maximize_rviz" pkg="openrosde_launch" type="maximize-app-window.bash" args="RViz" />

</launch>
