# Panes of the Fetch Robotics Fetch platform for 'RUN-TMUX-SESSION.bash', in the windows 'robot' and 'extra' of the session.
# Each line reads '<layouts> <window> <launch-file> [<arg:=value> ...]', where '<layouts>' is '*' or a comma-separated list such as 'default-gazebo,default-realworld'.
# The panes of the core, such as the FlexBE app and 'rosbridge', come from 'tmux/openrosde.panes'.

default-gazebo     robot  fetch_bringup_default_gazebo.launch
default-gazebo     robot  fetch_rviz_default.launch
default-gazebo     robot  fetch_moveit_default.launch
default-gazebo     robot  fetch_navigation_default_gazebo.launch
default-gazebo     robot  fetch_teleop_default.launch

default-realworld  robot  fetch_bringup_default_realworld.launch
default-realworld  robot  fetch_rviz_default.launch
default-realworld  robot  fetch_moveit_default.launch
default-realworld  robot  fetch_mapping_default.launch
default-realworld  robot  fetch_teleop_default.launch
